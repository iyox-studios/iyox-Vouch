<?xml version="1.0" encoding="utf-8"?>
<!-- Modern cell/preview attributes complement the dp sizing used by legacy launchers. -->
<appwidget-provider
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="UnusedAttribute"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="110dp"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_balance"
    android:previewLayout="@layout/widget_person_preview"
    android:description="@string/widget_person_description"
    android:widgetCategory="home_screen"
    android:configure="com.iyox.vouch.widget.PersonWidgetConfigurationActivity"
    android:widgetFeatures="reconfigurable" />
