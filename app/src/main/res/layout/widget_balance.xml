<?xml version="1.0" encoding="utf-8"?>
<!-- RemoteViews require platform tinting. Newer attributes have explicit legacy fallbacks. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="UseAppTint,UnusedAttribute"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_round"
    android:clipToOutline="true"
    android:foreground="@drawable/widget_feedback">
    <ImageView
        android:id="@+id/widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/widget_round"
        android:scaleType="fitXY"
        android:importantForAccessibility="no"
        android:tint="@color/widget_surface" />
    <ImageView
        android:id="@+id/widget_decoration"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:layout_gravity="top|end"
        android:translationX="65dp"
        android:translationY="-65dp"
        android:src="@drawable/widget_cookie"
        android:alpha="0.15"
        android:importantForAccessibility="no"
        android:tint="@color/widget_primary" />
    <ImageView
        android:id="@+id/widget_person_decoration"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_gravity="bottom|start"
        android:translationX="-65dp"
        android:translationY="55dp"
        android:src="@drawable/widget_pentagon"
        android:alpha="0.15"
        android:visibility="gone"
        android:importantForAccessibility="no"
        android:tint="@color/widget_primary" />
    <LinearLayout
        android:id="@+id/widget_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:orientation="horizontal">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">
                    <ImageView
                        android:id="@+id/widget_icon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="8dp"
                        android:src="@drawable/ic_payments"
                        android:importantForAccessibility="no"
                        android:tint="@color/widget_primary" />
                    <TextView
                        android:id="@+id/widget_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:layout_weight="1"
                        android:textStyle="bold"
                        android:text="@string/label_total_balance"
                        android:textColor="@color/widget_on_surface" />
                </LinearLayout>
                <include layout="@layout/widget_amount_and_badge" />
            </LinearLayout>
            <FrameLayout
                android:id="@+id/widget_count_side"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:visibility="gone" />
        </LinearLayout>
        <TextView
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />
        <LinearLayout
            android:id="@+id/widget_split"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">
            <FrameLayout
                android:id="@+id/given_tile"
                android:background="@drawable/widget_split_outline"
                android:clipToOutline="true"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:minHeight="54dp">
                <ImageView
                    android:id="@+id/given_background"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/widget_split_tile"
                    android:scaleType="fitXY"
                    android:importantForAccessibility="no"
                    android:tint="@color/widget_primary_container" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_vertical"
                    android:padding="10dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical">
                        <ImageView
                            android:id="@+id/given_icon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginEnd="6dp"
                            android:src="@drawable/ic_arrow_outward"
                            android:tint="@color/widget_on_primary_container"
                            android:importantForAccessibility="no" />
                    <TextView
                        android:id="@+id/given_label"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:text="@string/label_given"
                        android:textColor="@color/widget_on_primary_container" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/given_amount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="17sp"
                        android:fontFamily="sans-serif"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:textStyle="bold"
                        android:layout_marginTop="4dp"
                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="10sp"
                        android:autoSizeMaxTextSize="18sp"
                        android:autoSizeStepGranularity="1sp"
                        android:textColor="@color/widget_on_primary_container" />
                </LinearLayout>
            </FrameLayout>
            <TextView
                android:layout_width="6dp"
                android:layout_height="1dp" />
            <FrameLayout
                android:id="@+id/received_tile"
                android:background="@drawable/widget_split_outline"
                android:clipToOutline="true"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:minHeight="54dp">
                <ImageView
                    android:id="@+id/received_background"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/widget_split_tile"
                    android:scaleType="fitXY"
                    android:importantForAccessibility="no"
                    android:tint="@color/widget_error_container" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_vertical"
                    android:padding="10dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical">
                        <ImageView
                            android:id="@+id/received_icon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginEnd="6dp"
                            android:src="@drawable/ic_south_west"
                            android:tint="@color/widget_on_error_container"
                            android:importantForAccessibility="no" />
                    <TextView
                        android:id="@+id/received_label"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:text="@string/label_received"
                        android:textColor="@color/widget_on_error_container" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/received_amount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="17sp"
                        android:fontFamily="sans-serif"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:textStyle="bold"
                        android:layout_marginTop="4dp"
                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="10sp"
                        android:autoSizeMaxTextSize="18sp"
                        android:autoSizeStepGranularity="1sp"
                        android:textColor="@color/widget_on_error_container" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
        <include layout="@layout/widget_person_actions" />
    </LinearLayout>
</FrameLayout>
