<?xml version="1.0" encoding="utf-8"?>
<!-- RemoteViews require platform tinting and separate fixed-size icons for independent updates.
     Newer attributes have explicit legacy fallbacks. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="UseAppTint,UnusedAttribute,UseCompoundDrawables"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_round"
    android:clipToOutline="true"
    android:foreground="@drawable/widget_feedback">
    <ImageView
        android:id="@+id/widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/widget_round"
        android:scaleType="fitXY"
        android:importantForAccessibility="no"
        android:tint="@color/widget_surface" />
    <ImageView
        android:id="@+id/widget_decoration"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:layout_gravity="top|end"
        android:translationX="65dp"
        android:translationY="-65dp"
        android:src="@drawable/widget_cookie"
        android:alpha="0.15"
        android:importantForAccessibility="no"
        android:tint="@color/widget_primary" />
    <ImageView
        android:id="@+id/widget_person_decoration"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_gravity="bottom|start"
        android:translationX="-65dp"
        android:translationY="55dp"
        android:src="@drawable/widget_pentagon"
        android:alpha="0.15"
        android:visibility="gone"
        android:importantForAccessibility="no"
        android:tint="@color/widget_primary" />
    <LinearLayout
        android:id="@+id/widget_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">
        <include layout="@layout/widget_balance_header" />
        <TextView
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />
        <LinearLayout
            android:id="@+id/widget_split"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">
            <FrameLayout
                android:id="@+id/given_tile"
                android:background="@drawable/widget_split_outline"
                android:clipToOutline="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="36dp">
                <ImageView
                    android:id="@+id/given_background"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/widget_split_tile"
                    android:scaleType="fitXY"
                    android:importantForAccessibility="no"
                    android:tint="@color/widget_primary_container" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:padding="6dp">
                    <ImageView
                        android:id="@+id/given_icon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="4dp"
                        android:src="@drawable/ic_arrow_outward"
                        android:tint="@color/widget_on_primary_container"
                        android:importantForAccessibility="no" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/given_label"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/label_given"
                            android:textSize="14sp"
                        android:fontFamily="sans-serif-medium"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:textColor="@color/widget_on_primary_container" />
                        <TextView
                            android:id="@+id/given_amount"
                            android:layout_width="match_parent"
                            android:layout_height="24dp"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:gravity="center_vertical"
                            android:ellipsize="end"
                            android:autoSizeTextType="uniform"
                            android:autoSizeMinTextSize="8sp"
                            android:autoSizeMaxTextSize="18sp"
                            android:autoSizeStepGranularity="1sp"
                            android:textColor="@color/widget_on_primary_container" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>
            <TextView
                android:layout_width="1dp"
                android:layout_height="6dp" />
            <FrameLayout
                android:id="@+id/received_tile"
                android:background="@drawable/widget_split_outline"
                android:clipToOutline="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="36dp">
                <ImageView
                    android:id="@+id/received_background"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/widget_split_tile"
                    android:scaleType="fitXY"
                    android:importantForAccessibility="no"
                    android:tint="@color/widget_error_container" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:padding="6dp">
                    <ImageView
                        android:id="@+id/received_icon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="4dp"
                        android:src="@drawable/ic_south_west"
                        android:tint="@color/widget_on_error_container"
                        android:importantForAccessibility="no" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/received_label"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/label_received"
                            android:textSize="14sp"
                        android:fontFamily="sans-serif-medium"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:textColor="@color/widget_on_error_container" />
                        <TextView
                            android:id="@+id/received_amount"
                            android:layout_width="match_parent"
                            android:layout_height="24dp"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:gravity="center_vertical"
                            android:ellipsize="end"
                            android:autoSizeTextType="uniform"
                            android:autoSizeMinTextSize="8sp"
                            android:autoSizeMaxTextSize="18sp"
                            android:autoSizeStepGranularity="1sp"
                            android:textColor="@color/widget_on_error_container" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
        <include layout="@layout/widget_person_actions" />
    </LinearLayout>
</FrameLayout>
