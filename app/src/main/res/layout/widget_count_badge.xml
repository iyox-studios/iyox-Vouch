<?xml version="1.0" encoding="utf-8"?>
<!-- RemoteViews.addView requires an inflatable root; the badge background also overlays its text. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="UseAppTint,UnusedAttribute,MergeRootFrame"
    android:id="@+id/widget_count_badge"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/widget_count_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/widget_badge"
        android:scaleType="fitXY"
        android:tint="@color/widget_surface_high"
        android:importantForAccessibility="no" />
    <TextView
        android:id="@+id/widget_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:textSize="12sp"
        android:lineHeight="16sp"
        android:fontFamily="sans-serif-medium"
        android:textFontWeight="600"
        android:letterSpacing="0.0416667"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="@string/widget_preview_vouch_count"
        android:textColor="@color/widget_on_surface" />
</FrameLayout>
