<?xml version="1.0" encoding="utf-8"?>
<!-- RemoteViews require platform tinting and separate fixed-size icons for independent updates.
     Newer attributes have explicit legacy fallbacks. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="UseAppTint,UnusedAttribute,UseCompoundDrawables"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_round"
    android:clipToOutline="true"
    android:foreground="@drawable/widget_feedback">
    <ImageView
        android:id="@+id/widget_decoration"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_gravity="bottom|start"
        android:translationX="-65dp"
        android:translationY="55dp"
        android:src="@drawable/widget_pentagon"
        android:alpha="0.15"
        android:importantForAccessibility="no"
        android:tint="@color/widget_primary" />
    <LinearLayout
        android:id="@+id/widget_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">
            <ImageView
                android:id="@+id/widget_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/ic_person"
                android:importantForAccessibility="no"
                android:tint="@color/widget_primary" />
            <TextView
                android:id="@+id/widget_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:fontFamily="sans-serif"
                android:maxLines="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:layout_weight="1"
                android:textStyle="bold"
                android:text="@string/widget_preview_person"
                android:textColor="@color/widget_on_surface" />
        </LinearLayout>
        <TextView
            android:id="@+id/widget_amount"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:textSize="28sp"
            android:fontFamily="sans-serif"
            android:maxLines="1"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:layout_marginTop="4dp"
            android:textStyle="bold"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="12sp"
            android:autoSizeMaxTextSize="32sp"
            android:autoSizeStepGranularity="1sp"
            android:text="@string/widget_preview_balance"
            android:textColor="@color/widget_on_surface" />
        <include
            layout="@layout/widget_count_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />
        <TextView
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />
        <include
            layout="@layout/widget_person_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:visibility="visible" />
    </LinearLayout>
</FrameLayout>
