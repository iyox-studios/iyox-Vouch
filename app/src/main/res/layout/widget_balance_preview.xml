<?xml version="1.0" encoding="utf-8"?>
<!-- RemoteViews require platform tinting. Newer attributes have explicit legacy fallbacks. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="UseAppTint,UnusedAttribute"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_round"
    android:clipToOutline="true"
    android:foreground="@drawable/widget_feedback">
    <ImageView
        android:id="@+id/widget_decoration"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_gravity="top|end"
        android:translationX="65dp"
        android:translationY="-55dp"
        android:src="@drawable/widget_cookie"
        android:alpha="0.15"
        android:importantForAccessibility="no"
        android:tint="@color/widget_primary" />
    <LinearLayout
        android:id="@+id/widget_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">
            <ImageView
                android:id="@+id/widget_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/ic_arrow_outward"
                android:importantForAccessibility="no"
                android:tint="@color/widget_primary" />
            <TextView
                android:id="@+id/widget_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:fontFamily="sans-serif"
                android:maxLines="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:layout_weight="1"
                android:textStyle="bold"
                android:text="@string/label_total_balance"
                android:textColor="@color/widget_on_surface" />
        </LinearLayout>
        <TextView
            android:id="@+id/widget_amount"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:textSize="28sp"
            android:fontFamily="sans-serif"
            android:maxLines="1"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:layout_marginTop="4dp"
            android:textStyle="bold"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="12sp"
            android:autoSizeMaxTextSize="32sp"
            android:autoSizeStepGranularity="1sp"
            android:text="@string/widget_preview_balance"
            android:textColor="@color/widget_on_surface" />
        <include
            layout="@layout/widget_count_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />
        <TextView
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />
        <LinearLayout
            android:id="@+id/widget_split"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:background="@drawable/widget_split_outline">
                <ImageView
                    android:id="@+id/given_background"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/widget_split_tile"
                    android:scaleType="fitXY"
                    android:tint="@color/widget_primary_container"
                    android:importantForAccessibility="no" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:gravity="center_vertical">
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginEnd="4dp"
                        android:src="@drawable/ic_arrow_outward"
                        android:tint="@color/widget_on_primary_container"
                        android:importantForAccessibility="no" />
                    <TextView
                        android:id="@+id/given_label"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="24dp"
                        android:gravity="center_vertical"
                        android:text="@string/label_given"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-medium"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="8sp"
                        android:autoSizeMaxTextSize="12sp"
                        android:autoSizeStepGranularity="1sp"
                        android:textColor="@color/widget_on_primary_container" />
                    <TextView
                        android:id="@+id/given_amount"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="24dp"
                        android:layout_marginStart="6dp"
                        android:gravity="end|center_vertical"
                        android:text="@string/widget_preview_given"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="8sp"
                        android:autoSizeMaxTextSize="14sp"
                        android:autoSizeStepGranularity="1sp"
                        android:textColor="@color/widget_on_primary_container" />
                </LinearLayout>
            </FrameLayout>
            <TextView android:layout_width="1dp" android:layout_height="4dp" />
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:background="@drawable/widget_split_outline">
                <ImageView
                    android:id="@+id/received_background"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/widget_split_tile"
                    android:scaleType="fitXY"
                    android:tint="@color/widget_error_container"
                    android:importantForAccessibility="no" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:gravity="center_vertical">
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginEnd="4dp"
                        android:src="@drawable/ic_south_west"
                        android:tint="@color/widget_on_error_container"
                        android:importantForAccessibility="no" />
                    <TextView
                        android:id="@+id/received_label"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="24dp"
                        android:gravity="center_vertical"
                        android:text="@string/label_received"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-medium"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="8sp"
                        android:autoSizeMaxTextSize="12sp"
                        android:autoSizeStepGranularity="1sp"
                        android:textColor="@color/widget_on_error_container" />
                    <TextView
                        android:id="@+id/received_amount"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="24dp"
                        android:layout_marginStart="6dp"
                        android:gravity="end|center_vertical"
                        android:text="@string/widget_preview_received"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="8sp"
                        android:autoSizeMaxTextSize="14sp"
                        android:autoSizeStepGranularity="1sp"
                        android:textColor="@color/widget_on_error_container" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
