<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:orientation="vertical">
    <LinearLayout
        android:id="@+id/widget_amount_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/widget_amount"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="40dp"
            android:textSize="32sp"
            android:fontFamily="sans-serif"
            android:maxLines="1"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:textStyle="bold"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="12sp"
            android:autoSizeMaxTextSize="36sp"
            android:autoSizeStepGranularity="1sp"
            android:text="@string/widget_amount_placeholder"
            android:textColor="@color/widget_on_surface" />

    </LinearLayout>
    <FrameLayout
        android:id="@+id/widget_count_below"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp">
        <include layout="@layout/widget_count_badge" />
    </FrameLayout>
</LinearLayout>
