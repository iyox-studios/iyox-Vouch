<?xml version="1.0" encoding="utf-8"?>
<!-- Glance has no translation modifier. Keep vector offsets exact without widget-sized bitmaps. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="UseAppTint"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:importantForAccessibility="noHideDescendants">
    <ImageView
        android:id="@+id/widget_decoration"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:layout_gravity="top|end"
        android:translationX="65dp"
        android:translationY="-65dp"
        android:src="@drawable/widget_cookie"
        android:contentDescription="@null"
        android:alpha="0.15" />
    <ImageView
        android:id="@+id/widget_person_decoration"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_gravity="bottom|start"
        android:translationX="-65dp"
        android:translationY="55dp"
        android:src="@drawable/widget_pentagon"
        android:contentDescription="@null"
        android:alpha="0.15" />
</FrameLayout>
