opt_out_usage

# Fastfile for iyox-Vouch
default_platform(:android)

platform :android do
  before_all do
    # Load SOPS encrypted secrets if secrets.yaml is present
    secrets_path = ["secrets.yaml", "../secrets.yaml"].find { |f| File.exist?(f) }
    if secrets_path && (ENV["KEYSTORE_PASSWORD"].nil? || ENV["KEYSTORE_PASSWORD"].empty?)
      require "yaml"
      begin
        decrypted_raw = `sops -d #{secrets_path} 2>/dev/null`
        if $?.success? && !decrypted_raw.empty?
          decrypted = YAML.safe_load(decrypted_raw)
          if decrypted.is_a?(Hash)
            decrypted.each { |k, v| ENV[k.to_s] ||= v.to_s }
            UI.message("Loaded secrets from #{secrets_path} via SOPS")
          end
        end
      rescue => e
        UI.important("SOPS decryption skipped: #{e.message}")
      end
    end
  end

  desc "Build the signed Android App Bundle (.aab)"
  lane :build_release do
    gradle(
      task: "bundleRelease",
      project_dir: "./"
    )
  end

  desc "Build and upload release AAB to Google Play Store (default track: internal)"
  lane :release do |options|
    track = options[:track] || ENV["PLAY_STORE_TRACK"] || "internal"
    validate_only = options[:validate_only] || false

    # 1. Build the release bundle
    build_release

    # 2. Upload to Google Play
    upload_options = {
      package_name: "com.iyox.vouch",
      track: track,
      validate_only: validate_only,
      skip_upload_metadata: options[:skip_metadata] || false,
      skip_upload_images: options[:skip_images] || false,
      skip_upload_screenshots: options[:skip_screenshots] || false,
      skip_upload_changelogs: options[:skip_changelogs] || false
    }

    if ENV["SUPPLY_JSON_KEY_DATA"] && !ENV["SUPPLY_JSON_KEY_DATA"].empty?
      upload_options[:json_key_data] = ENV["SUPPLY_JSON_KEY_DATA"]
    elsif ENV["SUPPLY_JSON_KEY"] && !ENV["SUPPLY_JSON_KEY"].empty?
      upload_options[:json_key] = ENV["SUPPLY_JSON_KEY"]
    end

    upload_to_play_store(upload_options)
  end

  desc "Upload all store listing assets (metadata, icon, feature graphic, screenshots) from repo to Google Play without a new release"
  lane :publish_store_listing do |options|
    track = options[:track] || ENV["PLAY_STORE_TRACK"] || "internal"
    validate_only = options[:validate_only] || false

    upload_options = {
      package_name: "com.iyox.vouch",
      track: track,
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_changelogs: true,
      skip_upload_images: options[:skip_images] || false,
      skip_upload_screenshots: options[:skip_screenshots] || false,
      skip_upload_metadata: options[:skip_metadata] || false,
      validate_only: validate_only
    }

    if ENV["SUPPLY_JSON_KEY_DATA"] && !ENV["SUPPLY_JSON_KEY_DATA"].empty?
      upload_options[:json_key_data] = ENV["SUPPLY_JSON_KEY_DATA"]
    elsif ENV["SUPPLY_JSON_KEY"] && !ENV["SUPPLY_JSON_KEY"].empty?
      upload_options[:json_key] = ENV["SUPPLY_JSON_KEY"]
    end

    upload_to_play_store(upload_options)
  end

  desc "Upload screenshots only to Google Play without a new release"
  lane :publish_screenshots do |options|
    publish_store_listing(
      options.merge(
        skip_images: options.key?(:skip_images) ? options[:skip_images] : (options[:upload_images] ? false : true),
        skip_metadata: options.key?(:skip_metadata) ? options[:skip_metadata] : (options[:upload_metadata] ? false : true),
        skip_screenshots: false
      )
    )
  end

  desc "Pull current store listing metadata and graphics from Google Play Store into repo"
  lane :pull_metadata do |options|
    track = options[:track] || ENV["PLAY_STORE_TRACK"] || "internal"
    metadata_path = options[:metadata_path] || "./fastlane/metadata/android"

    require "fileutils"
    require "tmpdir"

    Dir.mktmpdir do |tmp_dir|
      sh("fastlane supply init --package_name com.iyox.vouch --metadata_path #{tmp_dir} --track #{track}")
      # Sync downloaded metadata into metadata_path, preserving existing files if needed
      FileUtils.cp_r(File.join(tmp_dir, "."), metadata_path)
    end
    UI.success("Successfully synchronized store listing metadata from Google Play into #{metadata_path}")
  end

  desc "Generate localized screenshots for all configured locales via screengrab"
  lane :screenshots do
    gradle(
      task: "assembleDebug assembleAndroidTest",
      project_dir: "./"
    )
    # Enable dark mode & Developer Settings' System UI Demo Mode on device
    sh("adb shell cmd uimode night yes")
    sh('adb shell \'settings put secure theme_customization_overlay_packages "{\"android.theme.customization.system_palette\":\"AAB0D5\",\"android.theme.customization.accent_color\":\"AAB0D5\",\"android.theme.customization.theme_style\":\"TONAL_SPOT\",\"android.theme.customization.color_source\":\"preset\"}"\'')
    sh("adb shell settings put global sysui_demo_allowed 1")
    sh("adb shell settings put system time_12_24 24")
    sh("adb shell settings put system status_bar_show_battery_percent 1")
    sh("adb shell settings put system font_scale 1.15")
    sh("adb shell am broadcast -a com.android.systemui.demo -e command enter")
    sh("adb shell am broadcast -a com.android.systemui.demo -e command clock -e hhmm 1700")
    sh("adb shell am broadcast -a com.android.systemui.demo -e command battery -e level 100 -e plugged false")
    sh("adb shell am broadcast -a com.android.systemui.demo -e command network -e wifi show -e level 4 -e fully true")
    sh("adb shell am broadcast -a com.android.systemui.demo -e command notifications -e visible false")
    screengrab
  end
end
