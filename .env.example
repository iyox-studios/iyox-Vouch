# ==============================================================================
# iyox-Vouch Fastlane & Signing Configuration
# Copy this file to .env and fill in your values.
# NEVER commit your actual .env file or credentials to git!
# ==============================================================================

# Keystore Signing Credentials (Play App Signing Upload Key)
KEYSTORE_PATH=iyox_vouch_keystore.jks
KEYSTORE_PASSWORD=your_keystore_password
KEY_ALIAS=your_key_alias
KEY_PASSWORD=your_key_password

# Google Play Console API Credentials
# Path to the service account JSON key file downloaded from Google Cloud / Play Console
SUPPLY_JSON_KEY=fastlane/play-store-credentials.json

# Default Google Play release track (e.g. internal, alpha, beta, production)
PLAY_STORE_TRACK=internal
